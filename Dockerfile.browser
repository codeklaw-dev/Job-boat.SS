# syntax=docker/dockerfile:1.7
FROM mcr.microsoft.com/playwright/python:v1.62.0-noble@sha256:aa81288e738725378becba5b3e06cb0f3a7f012a610e87e8d767a090ea3f740d
RUN --mount=type=secret,id=proxy_ca cp /run/secrets/proxy_ca /usr/local/share/ca-certificates/environment-proxy-ca.crt && update-ca-certificates && pip install --no-cache-dir playwright==1.62.0
WORKDIR /work
